rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveStaff() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().active == true;
    }

    function role() {
      return userDoc().role;
    }

    function isSuper() {
      return isActiveStaff() && role() == 'superadmin';
    }

    function isCmeisAdmin() {
      return isActiveStaff() && role() == 'admin_cmeis';
    }

    function isIsssiAdmin() {
      return isActiveStaff() && role() == 'admin_isssi';
    }

    function isCmeis() {
      return isActiveStaff() && role() in ['superadmin', 'admin_cmeis'];
    }

    function isIsssi() {
      return isActiveStaff() && role() in ['superadmin', 'admin_isssi'];
    }

    function isStaff() {
      return isActiveStaff() && role() in ['superadmin', 'admin_cmeis', 'admin_isssi'];
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    // Les règles ne filtrent pas les listes. Côté site public, chaque query
    // collection DOIT contraindre :
    //   status == 'published'  → pages, news, galleries, galleryImages,
    //                            documents, programs, admissions, paymentInfo
    //   visible == true        → partners
    // Sinon Firestore refuse toute la lecture (permission-denied).

    // Lecture / gestion utilisateurs : chacun son périmètre (sauf superadmin)
    function canReadUser(uid) {
      return isAuth() && (
        request.auth.uid == uid
        || isSuper()
        || (isCmeisAdmin() && resource.data.role == 'admin_cmeis')
        || (isIsssiAdmin() && resource.data.role == 'admin_isssi')
      );
    }

    function canWriteUserCreate() {
      return isSuper()
        || (isCmeisAdmin() && request.resource.data.role == 'admin_cmeis')
        || (isIsssiAdmin() && request.resource.data.role == 'admin_isssi');
    }

    function canWriteUserUpdate() {
      return isSuper()
        || (
          isCmeisAdmin()
          && resource.data.role == 'admin_cmeis'
          && request.resource.data.role == 'admin_cmeis'
        )
        || (
          isIsssiAdmin()
          && resource.data.role == 'admin_isssi'
          && request.resource.data.role == 'admin_isssi'
        );
    }

    match /users/{uid} {
      allow read: if canReadUser(uid);
      // Auto-création profil à la 1re connexion
      allow create: if isAuth() && request.auth.uid == uid;
      allow create: if canWriteUserCreate();
      allow update: if canWriteUserUpdate();
      allow update: if isAuth()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'active', 'permissions']);
      allow delete: if isSuper()
        || (isCmeisAdmin() && resource.data.role == 'admin_cmeis')
        || (isIsssiAdmin() && resource.data.role == 'admin_isssi');
    }

    match /pages/{id} {
      allow read: if isPublished() || isStaff();
      allow write: if isCmeis() || isIsssi();
    }

    match /homepage/{id} {
      allow read: if true;
      allow write: if isCmeis() || isIsssi() || isSuper();
    }

    match /news/{id} {
      allow read: if isPublished() || isStaff();
      allow write: if isCmeis() || isIsssi();
    }

    match /galleries/{id} {
      allow read: if isPublished() || isStaff();
      allow write: if isCmeis() || isIsssi();
    }

    match /galleryImages/{id} {
      allow read: if isPublished() || isStaff();
      allow write: if isCmeis() || isIsssi();
    }

    match /media/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /documents/{id} {
      allow read: if isPublished() || isStaff();
      allow write: if isStaff();
    }

    match /programs/{id} {
      allow read: if isPublished() || isIsssi() || isSuper();
      allow write: if isIsssi();
    }

    match /admissions/{id} {
      allow read: if isPublished() || isIsssi() || isSuper();
      allow write: if isIsssi();
    }

    match /registrations/{id} {
      allow create: if true
        && request.resource.data.keys().hasAll(['nom','prenom','email','telephone','filiereId'])
        && request.resource.data.email is string
        && request.resource.data.telephone is string;
      allow read, update: if isIsssi() || isSuper();
      allow delete: if isSuper();
    }

    match /payments/{id} {
      allow create: if isAuth();
      allow read, update: if isIsssi() || isSuper();
      allow delete: if isSuper();
    }

    match /paymentInfo/{id} {
      allow read: if !('status' in resource.data)
        || resource.data.status == 'published'
        || isIsssi()
        || isSuper();
      allow write: if isIsssi() || isSuper();
    }

    match /contacts/{id} {
      allow create: if true
        && request.resource.data.keys().hasAll(['name','email','subject','message']);
      allow read, update: if isCmeis() || isSuper();
      allow delete: if isSuper();
    }

    match /newsletter/{id} {
      allow create: if true && request.resource.data.email is string;
      allow read, update, delete: if isCmeis() || isSuper();
    }

    match /partners/{id} {
      allow read: if resource.data.visible == true || isCmeis() || isSuper();
      allow write: if isCmeis();
    }

    match /settings/{id} {
      allow read: if true;
      // Système : CMEIS / ISSSI / Super admin
      allow write: if isStaff();
    }

    match /auditLogs/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isSuper();
    }
  }
}
